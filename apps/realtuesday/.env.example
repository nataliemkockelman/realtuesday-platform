# Contact form email delivery (Resend). Copy to .env.local for local dev,
# and set the same keys in Vercel → Project → Settings → Environment Variables.

# Required. Create at https://resend.com/api-keys
RESEND_API_KEY=

# Optional. Where contact submissions are delivered.
# Defaults to hi@arealtuesday.com if unset.
CONTACT_TO=hi@arealtuesday.com

# Optional. The "from" address. The domain must be verified in Resend
# (https://resend.com/domains) or sends will fail.
# Defaults to "real Tuesday <hi@arealtuesday.com>" if unset.
CONTACT_FROM="real Tuesday <hi@arealtuesday.com>"

# ---------------------------------------------------------------------------
# Admin area (/admin) — interim Basic Auth gate (see middleware.ts).
# Both must be set or the /admin area stays locked (fail closed). Set these in
# Vercel as Production + Sensitive. They are replaced by Supabase Auth later.
# ---------------------------------------------------------------------------
ADMIN_USER=
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Supabase — the /admin data layer. Find these in your Supabase project under
# Project Settings → API.
# ---------------------------------------------------------------------------

# Required. Project URL, e.g. https://abcdefgh.supabase.co
# Safe to expose to the browser (hence NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_URL=

# Required for future client-side auth. The "anon public" key.
# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for the server-side admin client (lib/supabase.ts). The
# "service_role" key. SECRET — never prefix with NEXT_PUBLIC, never commit,
# never expose to the browser. Set in Vercel as Production + Sensitive.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Base URL used to build client-portal invite links. Defaults to
# https://arealtuesday.com if unset.
NEXT_PUBLIC_SITE_URL=https://arealtuesday.com
